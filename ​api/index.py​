            [
                {"text": "✅ Tasdiqlash", "callback_data": f"approve_{user_id}_{amount_int}"},
                {"text": "❌ Rad etish", "callback_data": f"reject_{user_id}"}
            ]
        ]
    }
    
    msg = f"💳 <b>Yangi to'lov so'rovi! (@Jv_asilbek)</b>\n\n" \
          f"👤 Foydalanuvchi: {username} (ID: <code>{user_id}</code>)\n" \
          f"💵 Summa: <b>{amount_int:,} so'm</b>\n" \
          f"📲 Usul: <b>{payment_method}</b>\n\n" \
          f"<i>Kartangizni tekshirib, quyidagi tugmani bosing:</i>"
    
    send_telegram_admin_notification(msg, reply_markup=keyboard)
    
    return jsonify({'success': True, 'message': 'So\'rov yuborildi'})

# Botdagi tugmalar bosilganda ishlaydigan webhook
@app.route('/api/telegram-webhook', methods=['POST'])
def telegram_webhook():
    data = request.json
    if "callback_query" in data:
        callback = data["callback_query"]
        callback_data = callback["data"]
        chat_id = callback["message"]["chat"]["id"]
        message_id = callback["message"]["message_id"]
        
        parts = callback_data.split("_")
        action = parts[0]
        user_id = parts[1]
        
        if action == "approve":
            amount = int(parts[2])
            if user_id not in user_balances:
                user_balances[user_id] = 0
            user_balances[user_id] += amount
            
            # Xabarni yangilaymiz
            requests.post(f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/editMessageText", json={
                "chat_id": chat_id,
                "message_id": message_id,
                "text": f"✅ <b>To'lov tasdiqlandi!</b>\n\nFoydalanuvchi (ID: {user_id}) balansiga <b>{amount:,} so'm</b> qo'shildi.",
                "parse_mode": "HTML"
            })
            
            # Foydalanuvchining o'ziga ham xabar yuborish
            try:
                requests.post(f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage", json={
                    "chat_id": user_id,
                    "text": f"🎉 Tabriklaymiz! Balansingizga {amount:,} so'm qo'shildi.",
                    "parse_mode": "HTML"
                })
            except:
                pass
                
        elif action == "reject":
            requests.post(f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/editMessageText", json={
                "chat_id": chat_id,
                "message_id": message_id,
                "text": f"❌ <b>To'lov rad etildi!</b> (ID: {user_id})",
                "parse_mode": "HTML"
            })
            
    return jsonify({'status': 'ok'})

@app.route('/api/balance', methods=['GET'])
def get_balance():
    user_id = request.args.get('user_id', 'default')
    balance = user_balances.get(user_id, 0)
    return jsonify({'balance': balance})

@app.route('/api/buy', methods=['POST'])
def buy():
    data = request.json
    user_id = data.get('user_id', 'default')
    price = int(data.get('price', 0))
    item_name = data.get('item_name')
    username = data.get('username')
    extra_info = data.get('extra_info')
    
    current_balance = user_balances.get(user_id, 0)
    if current_balance < price:
        return jsonify({'success': False, 'message': "Balansda yetarli mablag' yo'q!"})
    
    user_balances[user_id] -= price
    
    buy_msg = f"🛒 <b>Yangi xarid!</b>\n\n" \
              f"👤 Foydalanuvchi: {username}\n" \
              f"🛍 Mahsulot: {item_name}\n" \
              f"💰 Narxi: {price:,} so'm\n" \
              f"🎯 ID / Username: {extra_info}"
    send_telegram_admin_notification(buy_msg)
    
    return jsonify({'success': True, 'new_balance': user_balances[user_id]})

