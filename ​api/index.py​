from flask import Flask, request, jsonify
import requests

app = Flask(__name__)

# Foydalanuvchi balanslarini saqlash uchun lug'at
user_balances = {}

# Siz bergan bot token va admin ID raqami
TELEGRAM_BOT_TOKEN = "8965938163:AAE5-fezkpV-zUI_Ti4k5JRavmw6pWRjN78"
ADMIN_CHAT_ID = "8269688160"

def send_telegram_admin_notification(text):
    try:
        url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
        requests.post(url, json={"chat_id": ADMIN_CHAT_ID, "text": text, "parse_mode": "HTML"}, timeout=5)
    except Exception as e:
        print(f"Xabar yuborishda xatolik: {e}")

@app.route('/api/topup', methods=['POST'])
def topup():
    data = request.json
    user_id = data.get('user_id')
    amount = data.get('amount')
    username = data.get('username', 'Foydalanuvchi')
    payment_method = data.get('payment_method', 'Karta')
    
    if not user_id or not amount:
        return jsonify({'success': False, 'message': 'Maʼlumotlar yetishmaydi!'})
    
    # Click yoki Payme orqali to'lov so'rovi kelganda sizga Telegramga xabar yuboradi
    msg = f"💳 <b>Yangi to'lov so'rovi! (@Jv_asilbek)</b>\n\n" \
          f"👤 Foydalanuvchi: {username} (ID: <code>{user_id}</code>)\n" \
          f"💵 Summa: <b>{int(amount):,} so'm</b>\n" \
          f"📲 To'lov usuli: <b>{payment_method}</b>\n\n" \
          f"<i>Pulni kartangizda tekshirib, foydalanuvchi balansini qo'shib qo'yishingiz mumkin.</i>"
    
    send_telegram_admin_notification(msg)
    
    return jsonify({'success': True, 'message': 'So\'rov yuborildi'})

@app.route('/api/balance', methods=['GET'])
def get_balance():
    user_id = request.args.get('user_id', 'default')
    balance = user_balances.get(user_id, 0)
    return jsonify({'balance': balance})

@app.route('/api/check-pubg', methods=['POST'])
def check_pubg():
    data = request.json
    player_id = str(data.get('player_id', '')).strip()
    if not player_id:
        return jsonify({'success': False, 'message': 'ID kiritilmadi'})
    return jsonify({'success': True, 'nickname': f"ID: {player_id}"})

@app.route('/api/buy', methods=['POST'])
def buy():
    data = request.json
    user_id = data.get('user_id', 'default')
    price = int(data.get('price', 0))
    item_name = data.get('item_name')
    username = data.get('username')
    extra_info = data.get('extra_info')
    
    current_balance = user_balances.get(user_id, 0)
    if current_balance < price:
        return jsonify({'success': False, 'message': "Balansda yetarli mablag' yo'q!"})
    
    user_balances[user_id] -= price
    
    # Xarid qilinganda ham adminga xabar beradi
    buy_msg = f"🛒 <b>Yangi xarid amalga oshirildi!</b>\n\n" \
              f"👤 Foydalanuvchi: {username}\n" \
              f"🛍 Mahsulot: {item_name}\n" \
              f"💰 Narxi: {price:,} so'm\n" \
              f"🎯 ID / Username: {extra_info}"
    send_telegram_admin_notification(buy_msg)
    
    return jsonify({'success': True, 'new_balance': user_balances[user_id]})

if __name__ == '__main__':
    app.run(debug=True)
 

