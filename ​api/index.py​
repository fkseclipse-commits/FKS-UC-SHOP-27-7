    username = data.get('username', 'Foydalanuvchi')
    payment_method = data.get('payment_method', 'Avto Karta')
    
    if not user_id or not amount:
        return jsonify({'success': False, 'message': 'Maʼlumotlar yetishmaydi!'})
    
    amount_int = int(amount)
    
    # Adminga Tasdiqlash va Rad etish tugmalari bilan xabar yuboramiz
