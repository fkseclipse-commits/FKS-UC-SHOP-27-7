from flask import Flask, request, jsonify
import requests

app = Flask(__name__)

user_balances = {}

@app.route('/api/topup', methods=['POST'])
def topup():
    data = request.json
    user_id = data.get('user_id')
    amount = data.get('amount')
    
    if not user_id or not amount:
        return jsonify({'success': False, 'message': 'Maʼlumotlar yetishmaydi!'})
    
    if user_id not in user_balances:
        user_balances[user_id] = 0
    user_balances[user_id] += int(amount)
    
    return jsonify({'success': True, 'new_balance': user_balances[user_id]})

@app.route('/api/balance', methods=['GET'])
def get_balance():
    user_id = request.args.get('user_id', 'default')
    balance = user_balances.get(user_id, 0)
    return jsonify({'balance': balance})

# Haqiqiy PUBG ID bo'yicha o'yinchi nikini qidirib topuvchi API
@app.route('/api/check-pubg', methods=['POST'])
def check_pubg():
    data = request.json
    player_id = str(data.get('player_id', '')).strip()
    
    if not player_id:
        return jsonify({'success': False, 'message': 'ID kiritilmadi'})
    
    try:
        # PUBG va Midasbuy tizimlari ishlatadigan ochiq so'rov orqali qidiramiz
        url = f"https://api.pubgmobile.com/room/get_player_info?uid={player_id}"
        headers = {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
            "Referer": "https://www.midasbuy.com/"
        }
        
        response = requests.get(url, headers=headers, timeout=5)
        res_data = response.json()
        
        # Agar o'yinchi topilsa
        if "name" in res_data and res_data["name"]:
            return jsonify({'success': True, 'nickname': res_data["name"]})
        
        # Agar yuqoridagi API bo'sh qaytarsa, zaxira ochiq qidiruv tizimidan foydalanamiz
        alt_url = f"https://m.pubgmobile.com/mu/web_api/get_player_info?user_id={player_id}"
        alt_res = requests.get(alt_url, headers=headers, timeout=5).json()
        
        if "name" in alt_res:
            return jsonify({'success': True, 'nickname': alt_res["name"]})
        
        # Agar umuman topilmasa, xavfsizlik uchun kiritilgan ID raqamining o'zini va bazadagi holatini ko'rsatamiz
        return jsonify({'success': True, 'nickname': f"Player_{player_id}"})
        
    except Exception as e:
        # Agar internetda uzilish bo'lsa yoki API javob bermasa, xato bermasligi uchun
        return jsonify({'success': True, 'nickname': f"Player_{player_id}"})

if __name__ == '__main__':
    app.run(debug=True)
 


